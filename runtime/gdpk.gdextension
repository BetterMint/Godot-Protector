[configuration]

entry_symbol = "gdpk_library_init"
compatibility_minimum = "4.2"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://addons/gdpk/bin/libgdpk.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/gdpk/bin/libgdpk.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/gdpk/bin/libgdpk.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/gdpk/bin/libgdpk.windows.template_release.x86_64.dll"
macos.debug = "res://addons/gdpk/bin/libgdpk.macos.template_debug.framework"
macos.release = "res://addons/gdpk/bin/libgdpk.macos.template_release.framework"
android.debug.arm64 = "res://addons/gdpk/bin/libgdpk.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/gdpk/bin/libgdpk.android.template_release.arm64.so"

[dependencies]

